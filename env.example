# Arturito — the keys you need. Use your own. Never commit real values.
#
# setup.sh asks for the xAI key and saves it in ~/.hermes/.env for you.
# `hermes gateway setup` saves the Discord values.
# This file only shows which names Hermes expects, in case you set them by hand.

# Model provider: xAI (Grok). Get a key at https://console.x.ai/
XAI_API_KEY=

# Optional. Only set this if you use a different xAI endpoint.
# XAI_BASE_URL=https://api.x.ai/v1

# Discord (optional). Create a bot at https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# Your Discord user ID. Only these users can talk to your bot.
DISCORD_ALLOWED_USERS=
